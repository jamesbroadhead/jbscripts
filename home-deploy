#!/usr/bin/env bash

DEPLOY_FROM_DIR="$1"
bak="${HOME}/bak/$(date +%F)"

home_form() {
	# convert a <>/inside_dot_foo -> ~/.foo path
	home_form=$(echo "$1" | sed 's|.*dot_|'"$HOME"'/.|')
	echo ${home_form}
}

# Is $1 a path inside the same home repo we are deploying from?
# Used to tell "another overlay dir already claimed this" apart from "the user
# has real content here".
is_repo_path() {
	case "$1" in
		"${REPO_ROOT}"/*) return 0 ;;
		*) return 1 ;;
	esac
}

make_symlink() {
	# $1 : full path to a file which should be symlinked into ~
    dot_path="${1}"
	dot_name="$(basename ${1})"
	newpath=$(home_form $dot_path)

	if [ -L "${newpath}" ] ; then
		# broken symlink in place ([ -e ] follows the link)
		if ! [ -e "${newpath}" ] ; then
			#echo "would remove $newpath"
			rm "$newpath"
		# there is a symlink pointing to the correct location already
		elif [ "$(readlink ${newpath})" = "${dot_path}" ] ; then
			#echo "looks ok $newpath"
			return 0
		# A working symlink into this repo, but from a different overlay dir --
		# e.g. home/dot_gitconfig where we are now deploying home_mongodb. There
		# is nothing to preserve: the target is a tracked file that is still
		# there. Backing it up just filled ~/bak with dead symlinks every run,
		# and deploy runs `home` before the machine-specific dirs, so the last
		# writer is the specific one that is meant to win.
		elif is_repo_path "$(readlink -f "${newpath}")" ; then
			#echo "would take over $newpath from another overlay"
			rm "${newpath}"
		# a symlink to something outside the repo -- that is the user's, keep it
		else
			#echo "would replace $newpath"
			backup_old_content $newpath
		fi

	elif [ -e "${newpath}" ] ; then
		#echo "would backup $newpath"
		backup_old_content $newpath
	fi
	# at this point, there should be no file or symlink at $newpath already

	# If the dir already is symlinked, remove symlink and replace with a dir
	# (ideally this would walk all dirs between newpath_dir and $HOME)
	newpath_dir=$(dirname $newpath)
	if [ -L "${newpath_dir}" ] ; then
		rm ${newpath_dir}
	fi
	mkdir -p ${newpath_dir}
	ln -s "$dot_path" "$newpath"
}

# remove $1 from $HOME, so that a symlink can be created
backup_old_content() {
	# $1 filename in $HOME which should be moved to $bakpath
	path="$1"
	bakpath="$bak/$path"
	mkdir -p "$(dirname $bakpath)"
	echo "$path already existed! --> $bakpath"
	mv -i "$path" "${bakpath}"
}

confirmfile="$DEPLOY_FROM_DIR/.is_home_deploy_dir"
if ! [ -f $confirmfile ] ; then
	echo "Didn't find $confirmfile -- exiting"
	exit 1
fi

# The repo holding every overlay dir, fully resolved so it can be compared
# against `readlink -f` output. $DEPLOY_FROM_DIR is <repo>/home, <repo>/home_taktile, ...
REPO_ROOT="$(cd "${DEPLOY_FROM_DIR}" && pwd -P)"
REPO_ROOT="$(dirname "${REPO_ROOT}")"

# cleanup from older versions
for e in $DEPLOY_FROM_DIR/* ; do
	base=$(basename $e)
	if [ -d $e ] && [ -L $HOME/$base ] ; then
		echo "Symlinks to deployable dirs exist in your homedir. Bailing"
	fi
done

for abspath in $(find "$1" -wholename "*dot_*" -type f -exec readlink -f {} \;) ; do
	make_symlink "${abspath}"
done
